root = true

# Shared editor rules for Visual Studio, Rider, VS Code, and dotnet format.
[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

# Prefer:
# namespace SolidFullstackTemplate.Domain.Entities;
#
# over block-scoped namespace declarations.
[*.cs]
csharp_style_namespace_declarations = file_scoped:warning

[*.xml]
indent_size = 2
