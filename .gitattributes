* text=auto

# Windows-first line endings for repo text artifacts.
*.cs text eol=crlf
*.csproj text eol=crlf
*.sln text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf
*.xml text eol=crlf
*.json text eol=crlf
*.md text eol=crlf
*.http text eol=crlf
*.tf text eol=crlf
*.tfvars text eol=crlf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Unix shell scripts must keep LF.
*.sh text eol=lf
